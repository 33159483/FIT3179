{
    "$schema": "https://vega.github.io/schema/vega/v5.json",
    "description": "Treemap of disaster counts per Australian state (Zone), filtered like the stacked bar chart.",
    "width": 800,
    "height": 500,
    "padding": 5,
  
    "data": [
      {
        "name": "raw",
        "url": "https://raw.githubusercontent.com/33159483/FIT3179/refs/heads/main/Week10_HW/data/disaster-mapper-data-21-03-2023.csv",
        "format": {"type": "csv"},
        "transform": [
          { "type": "filter", "expr": "isValid(datum.Category) && datum.Category !== ''" },
          { "type": "filter", "expr": "datum.Zone !== 'Offshore'" },
          { "type": "formula", "as": "one", "expr": "1" }   // each row counts as 1
        ]
      },
      {
        "name": "tree",
        "source": "raw",
        "transform": [
          { "type": "nest", "keys": ["Zone"] },
          {
            "type": "treemap",
            "children": "values",              // 'nest' outputs children in 'values'
            "field": "one",                    // size by count of rows
            "method": "squarify",
            "paddingInner": 1,
            "paddingOuter": 2,
            "round": true,
            "size": [{"signal": "width"}, {"signal": "height"}]
          }
        ]
      },
      {
        "name": "zones",
        "source": "tree",
        "transform": [
          { "type": "filter", "expr": "datum.depth === 1" } // one rectangle per Zone
        ]
      }
    ],
  
    "scales": [
      {
        "name": "zoneColor",
        "type": "ordinal",
        "domain": {"data": "zones", "field": "name"},
        "range": {"scheme": "category20"}
      }
    ],
  
    "marks": [
      {
        "type": "rect",
        "from": {"data": "zones"},
        "encode": {
          "enter": {
            "x": {"field": "x0"},
            "y": {"field": "y0"},
            "x2": {"field": "x1"},
            "y2": {"field": "y1"},
            "fill": {"scale": "zoneColor", "field": "name"},
            "stroke": {"value": "white"},
            "strokeWidth": {"value": 1},
            "tooltip": {"signal": "{Zone: datum.name, Count: datum.value}"}
          },
          "update": {"opacity": {"value": 0.95}},
          "hover": {"opacity": {"value": 1.0}}
        }
      },
      {
        "type": "text",
        "from": {"data": "zones"},
        "encode": {
          "enter": {
            "x": {"signal": "datum.x0 + 4"},
            "y": {"signal": "datum.y0 + 14"},
            "text": {"signal": "datum.name + ' (' + datum.value + ')'" },
            "fill": {"value": "white"},
            "fontSize": {"value": 12},
            "fontWeight": {"value": "bold"},
            "baseline": {"value": "top"},
            "limit": {"signal": "max(0, datum.x1 - datum.x0 - 8)"}
          }
        }
      }
    ],
  
    "title": {"text": "Disaster Counts by State (Zone) what the fuck"}
  }
  