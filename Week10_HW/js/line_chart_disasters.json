{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": {
      "text": "Temporal Display of Disasters within Australia",
      "fontSize": 18,
      "fontWeight": "bold",
      "anchor": "middle"
    },
    "width": 800,
    "height": 400,
    "data": {
      "url": "https://raw.githubusercontent.com/33159483/FIT3179/refs/heads/main/Week10_HW/data/disaster-mapper-data-21-03-2023.csv"
    },
    "transform": [
      {
        "filter": "datum.Category != null && datum.Category != ''"
      },
      {
        "calculate": "split(datum['Start Date'], '/')",
        "as": "dateParts"
      },
      {
        "calculate": "datetime(toNumber(datum.dateParts[2]), toNumber(datum.dateParts[1]) - 1, toNumber(datum.dateParts[0]))",
        "as": "ParsedDate"
      },
      {
        "timeUnit": "year",
        "field": "ParsedDate",
        "as": "Year"
      },
      {
        "aggregate": [{"op": "count", "as": "DisasterCount"}],
        "groupby": ["Year", "Category"]
      },
      {
        "filter": "CategoryParam == 'All' || datum.Category == CategoryParam"
      }
    ],
    "params": [
      {
        "name": "CategoryParam",
        "value": "All",
        "bind": {
          "input": "select",
          "options": [
            "All",
            "Bushfire",
            "Flood",
            "Storm",
            "Cyclone",
            "Earthquake",
            "Landslide",
            "Tsunami",
            "Other"
          ],
          "name": "Select Disaster Category: "
        }
      }
    ],
    "mark": {
      "type": "line",
      "point": true
    },
    "encoding": {
      "x": {
        "field": "Year",
        "type": "temporal",
        "title": "Year"
      },
      "y": {
        "field": "DisasterCount",
        "type": "quantitative",
        "title": "Number of Disasters"
      },
      "color": {
        "field": "Category",
        "type": "nominal",
        "title": "Disaster Category"
      },
      "tooltip": [
        {"field": "Year", "type": "temporal", "title": "Year"},
        {"field": "Category", "type": "nominal", "title": "Category"},
        {"field": "DisasterCount", "type": "quantitative", "title": "Number of Disasters"}
      ]
    },
    "config": {
      "view": {"stroke": "transparent"}
    }
  }
  

